# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/lms_demo?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_QUEUE="video_transcode_queue"

# MinIO (Local S3)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_RAW_BUCKET="lms-raw-uploads"
S3_STREAM_BUCKET="lms-stream-media"
S3_FORCE_PATH_STYLE=true

# API Server
PORT=4000
API_BASE_URL="http://localhost:4000"

# Web Client
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_S3_ENDPOINT="http://localhost:9000"
NEXT_PUBLIC_STREAM_BUCKET="lms-stream-media"