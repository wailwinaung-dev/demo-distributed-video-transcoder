PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/lms_demo?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_QUEUE="video_transcode_queue"

# MinIO / S3
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_RAW_BUCKET="lms-raw-uploads"
S3_STREAM_BUCKET="lms-stream-media"
S3_FORCE_PATH_STYLE=true
